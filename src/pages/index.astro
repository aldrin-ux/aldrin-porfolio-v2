---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ToolsMarquee from "../components/ToolsMarquee.astro";
import WorkflowIllustration from "../components/WorkflowIllustration.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import { projects, services, siteMetadata } from "../content/site";
import { heroImage } from "../content/imageAssets";

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: siteMetadata.name,
    jobTitle: "Webflow Developer and Digital Experience Specialist",
    url: pageUrl,
    sameAs: siteMetadata.socialLinks,
    image: new URL(siteMetadata.image, Astro.site ?? Astro.url.origin).toString(),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteMetadata.title,
    url: pageUrl,
    inLanguage: siteMetadata.language,
  },
];
---

<BaseLayout title={siteMetadata.title} description={siteMetadata.description} jsonLd={jsonLd}>
  <section class="hero" data-hero-split>
    <div class="container">
      <span class="eyebrow hero-support">Aldrin Camacho - Webflow Developer & Digital Experience Specialist</span>
      <div class="hero-stage">
        <div class="hero-copy left">
          <h1>designer<span class="accent">.</span></h1>
          <p class="hero-support">I shape structure, visual rhythm, and usability before a site reaches Webflow.</p>
          <a class="text-link hero-support" href="#work">Explore design work ↗</a>
        </div>
        <img
          class="hero-portrait"
          src={heroImage.src}
          srcset={heroImage.srcset}
          sizes="(max-width: 900px) min(calc(100vw - 2rem), 520px), (max-width: 1280px) 36vw, 440px"
          width={heroImage.width}
          height={heroImage.height}
          alt="Aldrin Camacho designer and developer portrait"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="hero-copy right">
          <h2>developer<span class="accent">.</span></h2>
          <p class="hero-support">I build responsive Webflow marketing sites with CMS setup and technical SEO foundations.</p>
          <a class="text-link hero-support" href="#expertise">Technical services ↗</a>
        </div>
      </div>
      <div class="hero-actions hero-support">
        <a class="button" href="#work">View Selected Work ↗</a>
        <a class="text-link" href="/contact/">Get in touch ↗</a>
      </div>
    </div>
    <div class="hero-panel hero-panel--left" aria-hidden="true"></div>
    <div class="hero-panel hero-panel--right" aria-hidden="true"></div>
    <span class="hero-slash" aria-hidden="true">/</span>
  </section>

  <ToolsMarquee />

  <section class="section section--warm" id="work">
    <div class="container">
      <SectionHeading
        eyebrow="02 / Selected Work"
        title="Selected Work"
        description="Marketing websites developed under Dazlab, with my Webflow contributions outlined in each entry."
      />
      <div class="grid-two">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section" id="expertise">
    <div class="container">
      <SectionHeading
        eyebrow="03 / What I Do"
        title="What I Do"
      />
      <div class="services">
        {services.map((service) => (
          <article>
            <span>↗</span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--warm" id="workflow">
    <div class="container">
      <SectionHeading
        eyebrow="04 / Workflow"
        title="From Idea to Live Website"
      />
      <WorkflowIllustration />
    </div>
  </section>

  <section class="section" id="about">
    <div class="container about-split">
      <div>
        <span class="eyebrow">05 / About Me</span>
        <h2>Design-minded.<br />Development-focused<span class="accent">.</span></h2>
      </div>
      <div class="about-copy">
        <p>I'm a Webflow Developer & Digital Experience Specialist with a background in UX/UI and service design. My work includes Figma-to-Webflow implementation, responsive development, CMS setup, and technical SEO/AEO where applicable.</p>
        <p>As Dazlab's sole Webflow developer, I worked on marketing websites for Dazlab, Mortar, Handl, and Tangilla. Each featured entry describes my Webflow contribution and credits Dazlab.</p>
      </div>
    </div>
  </section>

  <section class="section section--warm" id="experience">
    <div class="container">
      <SectionHeading
        eyebrow="06 / Experience"
        title="Where I've Worked"
      />
      <ExperienceTimeline />
    </div>
  </section>

  <section class="section contact-strip" id="contact">
    <div class="container">
      <span class="eyebrow">07 / Contact</span>
      <h2>Let's build something better<span class="accent">.</span></h2>
      <p>Have a Webflow build, CMS cleanup, or ongoing site need? I’d be glad to talk.</p>
      <div>
        <a class="button" href="/contact/">Get in Touch ↗</a>
        <a class="text-link" href="https://www.linkedin.com/in/drin-camacho/" rel="noopener noreferrer" target="_blank">LinkedIn ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero-split]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const desktopMotion = window.matchMedia("(min-width: 901px) and (min-height: 660px)");

  if (hero) {
    const designer = hero.querySelector<HTMLElement>(".hero-copy.left h1");
    const developer = hero.querySelector<HTMLElement>(".hero-copy.right h2");
    const portrait = hero.querySelector<HTMLElement>(".hero-portrait");
    const panels = [...hero.querySelectorAll<HTMLElement>(".hero-panel")];
    const slash = hero.querySelector<HTMLElement>(".hero-slash");
    const headings = [designer, developer].filter(Boolean) as HTMLElement[];
    let running: Animation[] = [];
    let revealTimer: number | undefined;

    const finish = () => {
      hero.classList.remove("is-prep", "is-running");
      hero.classList.add("is-complete");
      panels.forEach((panel) => panel.remove());
      slash?.remove();
      headings.forEach((heading) => {
        heading.style.transform = "";
        heading.style.visibility = "";
      });
    };

    const skip = () => {
      running.forEach((animation) => animation.cancel());
      running = [];
      if (revealTimer) window.clearTimeout(revealTimer);
      finish();
    };

    const play = () => {
      const canAnimate = window.innerWidth >= 901 && window.innerHeight >= 660 && desktopMotion.matches;

      if (!designer || !developer || !portrait || reduceMotion.matches || !canAnimate) {
        finish();
        return;
      }

      running.forEach((animation) => animation.cancel());
      running = [];
      if (revealTimer) window.clearTimeout(revealTimer);

      hero.classList.remove("is-complete", "is-running");
      hero.classList.add("is-prep");
      headings.forEach((heading) => {
        heading.style.visibility = "visible";
        heading.style.transform = "none";
      });

      const heroRect = hero.getBoundingClientRect();
      const headingRects = headings.map((heading) => heading.getBoundingClientRect());
      const slashWidth = Math.min(44, heroRect.width * 0.045);
      const totalWidth = headingRects[0].width + headingRects[1].width + slashWidth;
      const startX = heroRect.left + (heroRect.width - totalWidth) / 2;
      const startY = heroRect.top + heroRect.height / 2;
      const startXs = [startX, startX + headingRects[0].width + slashWidth];

      headings.forEach((heading, index) => {
        const dx = startXs[index] - headingRects[index].left;
        const dy = startY - (headingRects[index].top + headingRects[index].height / 2);
        const animation = heading.animate(
          [
            { transform: `translate(${dx}px, ${dy}px)`, offset: 0 },
            { transform: `translate(${dx}px, ${dy}px)`, offset: 0.22 },
            { transform: "translate(0, 0)", offset: 0.9 },
            { transform: "translate(0, 0)", offset: 1 },
          ],
          {
            duration: 2300,
            easing: "cubic-bezier(.65, 0, .2, 1)",
            fill: "both",
          }
        );

        running.push(animation);
        animation.finished
          .then(() => {
            if (running.includes(animation)) {
              animation.cancel();
              heading.style.transform = "";
            }
          })
          .catch(() => {});
      });

      hero.classList.remove("is-prep");
      hero.classList.add("is-running");
      revealTimer = window.setTimeout(finish, 2300);
    };

    requestAnimationFrame(() => requestAnimationFrame(play));
    reduceMotion.addEventListener("change", skip);
    desktopMotion.addEventListener("change", skip);
    window.addEventListener("pagehide", skip);
  }
</script>

<style>
  .hero {
    --hero-header-height: 72px;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(5rem, 8vw, 6rem);
  }

  @media (min-width: 901px) and (min-height: 660px) {
    .hero {
      display: grid;
      min-height: calc(100svh - var(--hero-header-height));
      align-items: center;
    }
  }

  .hero > .container {
    position: relative;
    z-index: 3;
  }

  .hero-stage {
    display: grid;
    grid-template-columns: minmax(220px, 0.75fr) minmax(260px, 1fr) minmax(220px, 0.75fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .hero-portrait {
    width: min(100%, 520px);
    height: auto;
    margin-inline: auto;
    transform-origin: center;
    will-change: transform;
  }

  .hero-copy h1,
  .hero-copy h2 {
    position: relative;
    z-index: 8;
    margin: 0;
    font-size: clamp(3rem, 6vw, 3.875rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
    will-change: transform;
  }

  .hero-copy p {
    max-width: 320px;
    margin: 1rem 0 1.35rem;
    color: var(--muted);
    line-height: 1.65;
  }

  .right {
    text-align: right;
  }

  .right p {
    margin-left: auto;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .hero-support {
    transition: opacity 650ms ease, transform 650ms ease, visibility 0s linear 650ms;
  }

  .hero.is-prep .hero-support,
  .hero.is-running .hero-support {
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: none;
  }

  .hero.is-complete .hero-support {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: opacity 650ms ease, transform 650ms ease, visibility 0s;
  }

  .hero.is-complete .hero-copy p {
    transition-delay: 80ms;
  }

  .hero.is-complete .text-link,
  .hero.is-complete .hero-actions {
    transition-delay: 170ms;
  }

  .hero.is-prep .hero-panel {
    transform: translateX(0);
  }

  .hero.is-running .hero-panel--left {
    animation: hero-panel-left 2300ms cubic-bezier(.65, 0, .2, 1) both;
  }

  .hero.is-running .hero-panel--right {
    animation: hero-panel-right 2300ms cubic-bezier(.65, 0, .2, 1) both;
  }

  .hero.is-running .hero-slash {
    animation: hero-slash 2300ms ease both;
  }

  .hero.is-running .hero-portrait {
    animation: hero-portrait-scale 2300ms cubic-bezier(.22, 1, .36, 1) both;
  }

  .hero.is-complete .hero-portrait {
    transform: scale(1.08);
  }

  .hero-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 5;
    width: 50.1%;
    background: var(--background);
    pointer-events: none;
    will-change: transform;
  }

  .hero-panel--left {
    left: 0;
  }

  .hero-panel--right {
    right: 0;
  }

  .hero-slash {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 9;
    color: var(--accent);
    font-size: clamp(3rem, 6vw, 3.875rem);
    font-weight: 500;
    line-height: 1;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .hero.is-complete .hero-panel,
  .hero.is-complete .hero-slash {
    display: none;
  }

  @keyframes hero-panel-left {
    0%,
    22% {
      transform: translateX(0);
    }

    90%,
    100% {
      transform: translateX(-101%);
    }
  }

  @keyframes hero-panel-right {
    0%,
    22% {
      transform: translateX(0);
    }

    90%,
    100% {
      transform: translateX(101%);
    }
  }

  @keyframes hero-slash {
    0%,
    18% {
      opacity: 1;
    }

    35%,
    100% {
      opacity: 0;
    }
  }

  @keyframes hero-portrait-scale {
    0%,
    20% {
      transform: scale(0.86);
    }

    100% {
      transform: scale(1.08);
    }
  }

  .services {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .services article {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .services span {
    color: var(--accent);
  }

  .services h3 {
    margin: 1rem 0 0.45rem;
    font-size: 1rem;
  }

  .services p,
  .about-copy p,
  .contact-strip p {
    color: var(--muted);
  }

  .services p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .about-split {
    display: grid;
    grid-template-columns: minmax(260px, 0.7fr) minmax(320px, 1fr);
    gap: clamp(2rem, 7vw, 6rem);
  }

  .about-split h2,
  .contact-strip h2 {
    margin: 0.4rem 0 0;
    font-size: clamp(2.2rem, 5vw, 2.85rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .about-copy {
    display: grid;
    gap: 1rem;
  }

  .about-copy p {
    margin: 0;
  }

  .contact-strip .container {
    max-width: 820px;
    margin-left: max(calc((100vw - var(--max)) / 2), 0px);
  }

  .contact-strip p {
    max-width: 640px;
    margin: 1rem 0 2rem;
    font-size: 1.1rem;
  }

  .contact-strip div div {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero-stage,
    .about-split {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .right,
    .left {
      text-align: center;
    }

    .hero-copy p,
    .right p {
      margin-inline: auto;
    }

    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-panel,
    .hero-slash {
      display: none;
    }

    .hero.is-complete .hero-portrait {
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .hero-copy h1,
    .hero-copy h2 {
      font-size: 2.65rem;
    }

    .hero-actions,
    .contact-strip div div {
      align-items: stretch;
      flex-direction: column;
    }

    .services {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-support,
    .hero-portrait,
    .hero-panel,
    .hero-slash {
      animation: none !important;
      transition: none !important;
    }

    .hero-panel,
    .hero-slash {
      display: none;
    }

    .hero.is-complete .hero-portrait {
      transform: none;
    }
  }
</style>
