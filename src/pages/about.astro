---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import { Image } from "astro:assets";
import standingPortrait from "../assets/aldrin-standing-studio-portrait.png";
import { siteMetadata } from "../content/site";

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const title = "About - Aldrin Camacho";
const description =
  "About Aldrin Camacho, a Webflow Developer and Digital Experience Specialist with a UI/UX and product background.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: title,
  description,
  url: pageUrl,
  inLanguage: siteMetadata.language,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="section about-page">
    <div class="container intro">
      <div>
        <span class="eyebrow">About / Profile</span>
        <h1>Design-minded.<br />Development-focused<span class="accent">.</span></h1>
      </div>
      <figure>
        <Image
          src={standingPortrait}
          alt="Standing studio portrait of Aldrin Camacho"
          widths={[420, 640, 820]}
          sizes="(max-width: 760px) 100vw, 42vw"
          quality={88}
        />
      </figure>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container story">
      <p>I'm a Webflow Developer & Digital Experience Specialist with a background in UI/UX and product development. I turn Figma designs into responsive, maintainable websites with structured CMS architecture and technical SEO foundations.</p>
      <p>My experience spans SaaS marketing websites, product-studio projects, and ongoing site improvements. I focus on clean implementation, practical problem-solving, and systems teams can maintain.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Experience"
        title="Where I've Worked"
      />
      <ExperienceTimeline />
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding-top: clamp(3rem, 7vw, 5rem);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.74fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .intro > * {
    min-width: 0;
  }

  h1 {
    margin: 0.5rem 0 0;
    font-size: clamp(3.4rem, 8vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  figure {
    margin: 0;
    justify-self: end;
    width: min(100%, 520px);
  }

  img {
    width: 100%;
    height: auto;
    display: block;
  }

  .story {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 5vw, 4rem);
  }

  .story p {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  @media (max-width: 760px) {
    .intro,
    .story {
      grid-template-columns: 1fr;
    }

    .intro {
      gap: 2rem;
    }

    figure {
      justify-self: stretch;
      width: 100%;
    }

    img {
      max-height: 620px;
      object-fit: contain;
    }
  }

  @media (max-width: 360px) {
    h1 {
      font-size: 2.85rem;
    }
  }
</style>
