---
import { experience } from "../content/resolved";
---

<div class="timeline">
  {experience.map((item) => (
    <article>
      <span class="period">{item.period}</span>
      <div>
        <h3>{item.company}</h3>
        <p class="role">{item.role}</p>
      </div>
      <p>{item.description}</p>
    </article>
  ))}
</div>

<style>
  .timeline {
    border-top: 1px solid var(--border);
  }

  article {
    display: grid;
    grid-template-columns: 220px minmax(180px, 0.45fr) minmax(260px, 1fr);
    gap: 1.5rem;
    border-bottom: 1px solid var(--border);
    padding: 1.4rem 0;
  }

  .period {
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
  }

  h3,
  p {
    margin: 0;
  }

  h3 {
    font-size: 1rem;
    line-height: 1.3;
  }

  .role,
  article > p {
    color: var(--muted);
    font-size: 0.86rem;
  }

  @media (max-width: 760px) {
    article {
      grid-template-columns: 1fr;
      gap: 0.45rem;
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      background: #fff;
      padding: 1rem;
      margin-top: 0.75rem;
    }

    .timeline {
      border-top: 0;
    }
  }
</style>
