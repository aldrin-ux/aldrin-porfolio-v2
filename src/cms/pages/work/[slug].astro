---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CaseStudyLayout from "../../components/CaseStudyLayout.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import { caseStudies, projects, siteMetadata } from "../../../content/resolved";

export async function getStaticPaths() {
  const { projects, content } = await import("../../../content/resolved");
  return projects.filter(project => !content.localProjectSlugs || content.localProjectSlugs.includes(project.slug))
    .map(project => ({ params: { slug: project.slug } }));
}
const { slug } = Astro.params;
const caseStudy = caseStudies[slug!];
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const title = caseStudy.seoTitle;
const description = caseStudy.seoDescription;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: title,
    headline: caseStudy.heading,
    about: { "@type": "Thing", name: caseStudy.title },
    creditText: caseStudy.creditText,
    description,
    url: pageUrl,
    image: new URL(caseStudy.socialImage, Astro.site ?? Astro.url.origin).toString(),
    author: {
      "@type": "Person",
      name: siteMetadata.name,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: new URL("/", Astro.site ?? Astro.url.origin).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Work",
        item: new URL("/work/", Astro.site ?? Astro.url.origin).toString(),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: caseStudy.title,
        item: pageUrl,
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} image={caseStudy.socialImage} noindex={caseStudy.noindex} jsonLd={jsonLd}>
  <CaseStudyLayout study={caseStudy} />
  <section class="section">
    <div class="container">
      <span class="eyebrow">Next Work</span>
      <h2>More selected projects<span class="accent">.</span></h2>
      <div class="grid-two">
        {projects.filter((project) => project.slug !== slug).slice(0, 2).map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h2 {
    margin: 0.4rem 0 2rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }
</style>
