---
---

<form
  class="contact-form"
  name="portfolio-inquiry"
  method="POST"
  action="/contact/success/"
  data-netlify="true"
  netlify-honeypot="bot-field"
  aria-describedby="form-note form-required-note"
>
  <input type="hidden" name="form-name" value="portfolio-inquiry" />
  <p class="bot-field" aria-hidden="true">
    <label>Do not fill this out if you are human <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>
  <p id="form-required-note" class="form-required-note">All visible fields are required.</p>
  <fieldset class="scope">
    <legend>Inquiry type</legend>
    <label>
      <input id="scope-project" type="radio" name="scope" value="Website Project" checked />
      Website Project
    </label>
    <label>
      <input id="scope-role" type="radio" name="scope" value="Remote Role" />
      Remote Role
    </label>
  </fieldset>
  <label for="contact-name">
    <span>Your name or studio</span>
    <input id="contact-name" type="text" name="name" placeholder="Your name or studio" autocomplete="name" required />
  </label>
  <label for="contact-email">
    <span>Business email</span>
    <input id="contact-email" type="email" name="email" placeholder="your@company.com" autocomplete="email" required />
  </label>
  <label for="contact-message">
    <span>Project details or message</span>
    <textarea id="contact-message" name="message" rows="6" placeholder="Tell me about your project scope, timeline, and goals..." required></textarea>
  </label>
  <button class="button" type="submit">Send Inquiry ↗</button>
  <p id="form-note">Direct communication. No spam or third-party mailing lists.</p>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 1.2rem;
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    background: #fff;
    padding: clamp(1.25rem, 4vw, 2.25rem);
  }

  .scope {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 0;
    border: 0;
    padding: 0;
  }

  legend {
    margin-bottom: 0.45rem;
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .scope label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    padding: 0.85rem;
    color: var(--ink);
    font-size: 0.9rem;
  }

  label {
    display: grid;
    gap: 0.45rem;
  }

  span {
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    background: #fff;
    color: var(--ink);
    padding: 0.8rem 0.9rem;
  }

  textarea {
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    border-color: var(--ink);
    outline: 2px solid color-mix(in srgb, var(--accent), transparent 75%);
  }

  button {
    width: fit-content;
  }

  p {
    margin: 0;
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
  }

  .bot-field {
    display: none;
  }

  .form-required-note {
    margin-top: -0.2rem;
  }

  @media (max-width: 520px) {
    .scope {
      grid-template-columns: 1fr;
    }
  }
</style>
