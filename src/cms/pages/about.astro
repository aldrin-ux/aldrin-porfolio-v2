---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ExperienceTimeline from "../../components/ExperienceTimeline.astro";
import { Image } from "astro:assets";
import standingPortrait from "../../assets/aldrin-standing-studio-portrait.png";
import { siteMetadata, pages } from "../../content/resolved";

const p = pages.about;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const title = p.title;
const description = p.description;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: title,
  description,
  url: pageUrl,
  inLanguage: siteMetadata.language,
};
---

<BaseLayout title={title} description={description} image={p.image} noindex={p.noindex} jsonLd={jsonLd}>
  <section class="section about-page">
    <div class="container intro">
      <div>
        <span class="eyebrow">{p.profile.eyebrow}</span>
        <h1>{p.profileHeading[0]}<br />{p.profileHeading[1]}<span class="accent">.</span></h1>
      </div>
      <figure>
        <Image
          src={standingPortrait}
          alt={p.portrait.alt}
          widths={[420, 640, 820]}
          sizes="(max-width: 760px) 100vw, 42vw"
          quality={88}
        />
      </figure>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container story">
      <p>{p.paragraphs[0]}</p>
      <p>{p.paragraphs[1]}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow={p.experience.eyebrow}
        title={p.experience.heading}
      />
      <ExperienceTimeline />
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding-top: clamp(3rem, 7vw, 5rem);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.74fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .intro > * {
    min-width: 0;
  }

  h1 {
    margin: 0.5rem 0 0;
    font-size: clamp(3.4rem, 8vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  figure {
    margin: 0;
    justify-self: end;
    width: min(100%, 520px);
  }

  img {
    width: 100%;
    height: auto;
    display: block;
  }

  .story {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 5vw, 4rem);
  }

  .story p {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  @media (max-width: 760px) {
    .intro,
    .story {
      grid-template-columns: 1fr;
    }

    .intro {
      gap: 2rem;
    }

    figure {
      justify-self: stretch;
      width: 100%;
    }

    img {
      max-height: 620px;
      object-fit: contain;
    }
  }

  @media (max-width: 360px) {
    h1 {
      font-size: 2.85rem;
    }
  }
</style>
