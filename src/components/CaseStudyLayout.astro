---
import { imageAssets } from "../content/imageAssets";

interface Detail {
  0: string;
  1: string;
}

interface Props {
  study: {
    eyebrow: string;
    heading: string;
    title: string;
    url: string;
    image: string;
    imageAlt?: string;
    summary: string;
    details: Detail[];
    sections: { title: string; text: string }[];
    missingFacts?: string[];
  };
}

const { study } = Astro.props;
const sections = study.sections.map((section) => ({
  ...section,
  title: section.title.trim().replace(/\.+$/, ""),
}));
const missingFacts = study.missingFacts ?? [];
const image = imageAssets[study.image]?.study;
---

<section class="case-hero section">
  <div class="container">
    <a class="text-link" href="/work/">← Back to Selected Work</a>
    <div class="hero-grid">
      <div>
        <span class="eyebrow">{study.eyebrow}</span>
        <h1>{study.heading}</h1>
      </div>
      <p>{study.summary}</p>
    </div>
    <div class="meta-grid">
      {study.details.map(([label, value]) => (
        <div>
          <span>{label}</span>
          <strong>{value}</strong>
        </div>
      ))}
    </div>
    <a class="button live-link" href={study.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${study.title} live website`}>
      Visit Live Website ↗
    </a>
    <figure>
      <img
        src={image?.src ?? study.image}
        srcset={image?.srcset}
        sizes="(max-width: 1280px) calc(100vw - 2rem), 1200px"
        width={image?.width}
        height={image?.height}
        alt={study.imageAlt ?? `${study.title} production website preview`}
        loading="eager"
        decoding="async"
      />
    </figure>
  </div>
</section>

{(sections.length > 0 || missingFacts.length > 0) && (
  <section class="section section--warm">
    <div class="container narrative">
      {sections.map((section) => (
        <article>
          <h2>{section.title}<span class="accent">.</span></h2>
          <p>{section.text}</p>
        </article>
      ))}
      {missingFacts.length > 0 && (
        <article>
          <h2>Portfolio status<span class="accent">.</span></h2>
          <div class="missing-facts">
            {missingFacts.map((fact) => <p>{fact}</p>)}
          </div>
        </article>
      )}
    </div>
  </section>
)}

<style>
  .case-hero {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
    margin-top: 2rem;
  }

  .hero-grid > * {
    min-width: 0;
  }

  h1 {
    margin: 0.5rem 0 0;
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.98;
    overflow-wrap: anywhere;
  }

  .hero-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 3rem;
  }

  .meta-grid div {
    border-top: 1px solid var(--border);
    padding-top: 0.85rem;
  }

  .meta-grid span {
    display: block;
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .meta-grid strong {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .live-link {
    margin-top: 2rem;
  }

  figure {
    overflow: hidden;
    margin: 3rem 0 0;
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    background: var(--surface-soft);
  }

  figure img {
    width: 100%;
    max-height: 720px;
    object-fit: cover;
    object-position: top;
  }

  .narrative {
    display: grid;
    gap: 1px;
    border-top: 1px solid var(--border);
  }

  .narrative article {
    display: grid;
    grid-template-columns: minmax(220px, 0.42fr) minmax(300px, 1fr);
    gap: 2rem;
    border-bottom: 1px solid var(--border);
    padding: 2rem 0;
  }

  .narrative h2,
  .narrative p {
    margin: 0;
  }

  .narrative h2 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .narrative p,
  .missing-facts {
    color: var(--muted);
  }

  .missing-facts {
    display: grid;
    gap: 0.75rem;
  }

  @media (max-width: 760px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .eyebrow {
      overflow-wrap: anywhere;
    }

    .meta-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 820px) {
    .narrative article {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
