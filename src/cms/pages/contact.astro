---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/ContactForm.astro";
import { siteMetadata, pages } from "../../content/resolved";

const p = pages.contact;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const title = p.title;
const description = p.description;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: title,
  description,
  url: pageUrl,
  inLanguage: siteMetadata.language,
};
---

<BaseLayout title={title} description={description} image={p.image} noindex={p.noindex} jsonLd={jsonLd}>
  <section class="section contact-hero">
    <div class="container">
      <span class="eyebrow">{p.hero.eyebrow}</span>
      <h1>{p.hero.heading}<span class="accent">.</span></h1>
      <Fragment set:html={p.bodyHtml} />
    </div>
  </section>

  <section class="section section--warm">
    <div class="container contact-grid">
      <aside>
        <span class="eyebrow">{p.options.eyebrow}</span>
        <article>
          <h2>{p.options.items[0].title}<span class="accent">.</span></h2>
          <p>{p.options.items[0].text}</p>
        </article>
        <article>
          <h2>{p.options.items[1].title}<span class="accent">.</span></h2>
          <p>{p.options.items[1].text}</p>
        </article>
        <a class="text-link" href={p.options.actions[0].href} rel={p.options.actions[0].newWindow ? "noopener noreferrer" : undefined} target={p.options.actions[0].newWindow ? "_blank" : undefined}>{p.options.actions[0].label}</a>
      </aside>
      <ContactForm />
    </div>
  </section>

  <section class="section">
    <div class="container working">
      <h2>{p.working.heading}<span class="accent">.</span></h2>
      <div>
        <article>
          <h3>{p.working.items[0].title}</h3>
          <p>{p.working.items[0].text}</p>
        </article>
        <article>
          <h3>{p.working.items[1].title}</h3>
          <p>{p.working.items[1].text}</p>
        </article>
        <article>
          <h3>{p.working.items[2].title}</h3>
          <p>{p.working.items[2].text}</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding-top: clamp(3rem, 7vw, 5rem);
  }

  h1 {
    max-width: 880px;
    margin: 0.5rem 0 1rem;
    font-size: clamp(3.2rem, 8vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .contact-hero :global(p) {
    margin: 0;
    max-width: 680px;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(260px, 0.65fr) minmax(320px, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
  }

  aside {
    display: grid;
    align-content: start;
    gap: 1.2rem;
  }

  aside article {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  h2,
  h3,
  p {
    margin: 0;
  }

  aside h2 {
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.3;
  }

  aside p,
  .working p {
    color: var(--muted);
  }

  .working {
    display: grid;
    gap: 2rem;
  }

  .working > h2 {
    max-width: 640px;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .working > div {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .working article {
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.2rem;
  }

  .working h3 {
    margin-bottom: 0.7rem;
  }

  @media (max-width: 800px) {
    .contact-grid,
    .working > div {
      grid-template-columns: 1fr;
    }
  }
</style>
